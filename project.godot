; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wizard Factory Game"
run/main_scene="uid://difmmyl136k4e"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*uid://bpgjyxx1vsxna"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/initial_position_type=3
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gaea/editor/plugin.cfg", "res://addons/gaea/plugin.cfg", "res://addons/gaea/runtime/plugin.cfg", "res://addons/gitot/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://custom_nodes/": "orange",
"res://pixel_art/": "purple",
"res://scenes/": "green"
}

[gaea]

nodes/custom_nodes_path="res://custom_nodes"

[global_group]

interactable="Objects interactable by mouse click"
inventoryPage="Object designed to hold inventory objects and slots."
playerInteractArea="Members of this group overlap currently interactable structures."
destructable=""

